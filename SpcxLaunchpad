<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<title>Owner 管理面板 — BSC & Shibarium</title>
<script src="https://cdn.jsdelivr.net/npm/ethers@6.13.2/dist/ethers.umd.min.js"></script>
<style>
  /* === BASE === */
  :root{
    --bg:#0b0f17;--panel:#121826;--panel2:#1a2336;--border:#243149;
    --text:#e8edf7;--muted:#8794ab;--accent:#7cc4ff;--accent2:#56e0c4;
    --warn:#ffb454;--danger:#ff6b7a;--ok:#56e08a;
    --mono:'SFMono-Regular',Consolas,'Liberation Mono',Menlo,monospace;
  }
  *{box-sizing:border-box}
  html,body{margin:0;background:var(--bg);color:var(--text);font:14px/1.55 system-ui,-apple-system,"Segoe UI","PingFang SC","Microsoft YaHei",sans-serif}
  a{color:var(--accent);text-decoration:none}
  a:hover{text-decoration:underline}
  .mono{font-family:var(--mono)}
  header{position:sticky;top:0;z-index:50;background:rgba(11,15,23,.95);backdrop-filter:blur(8px);border-bottom:1px solid var(--border);padding:14px 24px;display:flex;align-items:center;gap:16px;flex-wrap:wrap}
  header h1{font-size:16px;margin:0;letter-spacing:.5px}
  header .grow{flex:1}
  main{max-width:1240px;margin:0 auto;padding:24px}
  /* === CONTROLS === */
  button{background:var(--accent);color:#001827;border:0;border-radius:6px;padding:8px 14px;font-weight:600;cursor:pointer;transition:.15s;font-size:13px}
  button:hover{filter:brightness(1.1)}
  button:disabled{opacity:.4;cursor:not-allowed}
  button.ghost{background:transparent;color:var(--text);border:1px solid var(--border)}
  button.ghost:hover{border-color:var(--accent);color:var(--accent)}
  button.warn{background:var(--warn);color:#3a2200}
  button.danger{background:var(--danger);color:#3a0000}
  button.ok{background:var(--ok);color:#003a16}
  select,input{background:var(--panel2);color:var(--text);border:1px solid var(--border);border-radius:6px;padding:8px 10px;font-size:13px;font-family:inherit;outline:0}
  select:focus,input:focus{border-color:var(--accent)}
  input.mono{font-family:var(--mono);font-size:12px}
  label{font-size:12px;color:var(--muted);display:block;margin-bottom:4px}
  /* === LAYOUT === */
  .card{background:var(--panel);border:1px solid var(--border);border-radius:10px;padding:18px;margin-bottom:18px}
  .card h2{margin:0 0 14px;font-size:15px;display:flex;align-items:center;gap:8px;border-bottom:1px solid var(--border);padding-bottom:10px}
  .card h2 .tag{font-size:10px;background:var(--panel2);color:var(--muted);padding:2px 8px;border-radius:10px;font-weight:400;letter-spacing:.5px}
  .card h3{margin:16px 0 8px;font-size:13px;color:var(--accent2);text-transform:uppercase;letter-spacing:1px}
  .row{display:flex;gap:10px;align-items:end;flex-wrap:wrap}
  .row > *{flex:1;min-width:180px}
  .row > button{flex:0 0 auto}
  .grid2{display:grid;grid-template-columns:repeat(auto-fit,minmax(360px,1fr));gap:14px}
  .stat{background:var(--panel2);border-radius:8px;padding:10px 12px}
  .stat .k{font-size:11px;color:var(--muted);text-transform:uppercase;letter-spacing:.6px}
  .stat .v{font-family:var(--mono);font-size:12px;margin-top:3px;word-break:break-all}
  .pill{display:inline-block;padding:2px 8px;border-radius:10px;font-size:11px;background:var(--panel2);color:var(--muted)}
  .pill.ok{background:rgba(86,224,138,.15);color:var(--ok)}
  .pill.warn{background:rgba(255,180,84,.15);color:var(--warn)}
  .pill.danger{background:rgba(255,107,122,.15);color:var(--danger)}
  hr{border:0;border-top:1px solid var(--border);margin:16px 0}
  /* === LOG === */
  #log{position:fixed;right:18px;bottom:18px;width:380px;max-height:50vh;overflow:auto;background:#000b;border:1px solid var(--border);border-radius:8px;padding:10px;font-family:var(--mono);font-size:11px;line-height:1.5;display:none;z-index:80}
  #log.show{display:block}
  #log .entry{padding:4px 0;border-bottom:1px dashed #2a3a55}
  #log .entry:last-child{border:0}
  #log .ts{color:var(--muted)}
  #log .err{color:var(--danger)}
  #log .ok{color:var(--ok)}
  #log .info{color:var(--accent)}
  #logToggle{position:fixed;right:18px;bottom:18px;z-index:79}
  /* === MISC === */
  .danger-zone{border:1px dashed var(--danger);border-radius:8px;padding:12px;margin-top:10px;background:rgba(255,107,122,.04)}
  .danger-zone h3{color:var(--danger)!important;margin-top:0}
  .hint{font-size:11px;color:var(--muted);margin-top:4px;line-height:1.5}
  .net-pill{display:inline-block;padding:2px 8px;border-radius:10px;font-size:11px;font-weight:600;background:#f3ba2f;color:#000}
  .net-pill.shib{background:#ff7a59;color:#fff}
  details{margin-top:8px}
  details summary{cursor:pointer;color:var(--muted);font-size:12px;padding:4px 0}
  details summary:hover{color:var(--text)}
  .copy{cursor:pointer;color:var(--muted);font-size:10px;margin-left:4px}
  .copy:hover{color:var(--accent)}
  @media (max-width:700px){
    main{padding:12px}
    #log{width:calc(100% - 36px)}
    header{padding:10px 14px}
    header h1{font-size:14px}
  }
</style>
</head>
<body>

<header>
  <h1>🛡️ Owner 管理面板</h1>
  <div>
    <label>网络</label>
    <select id="netSelect">
      <option value="bsc">BSC Mainnet (56)</option>
      <option value="shibarium">Shibarium Mainnet (109)</option>
    </select>
  </div>
  <div class="grow"></div>
  <span id="netStatus" class="pill">未连接</span>
  <button id="connectBtn">连接钱包</button>
</header>

<main>
  <div id="walletInfo" class="card" style="display:none">
    <h2>当前会话 <span class="tag" id="netTag">—</span></h2>
    <div class="grid2">
      <div class="stat"><div class="k">连接钱包</div><div class="v" id="wAddr">—</div></div>
      <div class="stat"><div class="k">原生代币余额</div><div class="v" id="wBal">—</div></div>
      <div class="stat"><div class="k">链 ID</div><div class="v" id="wChain">—</div></div>
      <div class="stat"><div class="k">Block</div><div class="v" id="wBlock">—</div></div>
    </div>
  </div>

  <div id="overview" class="card">
    <h2>合约状态总览 <button class="ghost" style="margin-left:auto;font-size:11px;padding:4px 10px" id="refreshAll">🔄 刷新</button></h2>
    <div id="overviewBody" class="hint">连接钱包后将自动读取链上状态。</div>
  </div>

  <div id="sections"><!-- 动态填充 --></div>

  <div class="card" style="border-color:rgba(255,180,84,.4)">
    <h2 style="color:var(--warn)">⚠️ 安全提示</h2>
    <ul style="color:var(--muted);font-size:12px;line-height:1.8;padding-left:20px;margin:0">
      <li>本面板纯前端单文件，不向任何服务器发送数据；所有交易由你本地钱包签名后通过你选择的网络 RPC 直接广播。</li>
      <li><b>转移所有权采用 2 步模式</b>：第 1 步当前 owner 调用 transferOwnership 设置 pendingOwner；第 2 步必须由新 owner 自己调用 acceptOwnership。</li>
      <li><b>Treasury 大额提款 / ERC20 救援</b>有 24 小时 timelock；先 propose，到期后再 execute；中途可 cancel。</li>
      <li><b>TokenDeployer.admin 是 immutable</b>，链上无任何函数可改；但 setFactory 只能调用一次且已用完，无剩余权限。</li>
      <li>每次发送交易前请仔细核对 MetaMask 弹窗里的目标合约地址、函数名和参数。</li>
    </ul>
  </div>
</main>

<button id="logToggle" class="ghost" style="font-size:11px;padding:4px 10px">📋 日志</button>
<div id="log"></div>

<script>
/* ============================================================
   配置与 ABI
   ============================================================ */
const CONFIG = {
  bsc: {
    name: "BSC Mainnet",
    chainId: 56,
    chainIdHex: "0x38",
    rpc: "https://bsc-dataseed.binance.org",
    explorer: "https://bscscan.com",
    nativeSymbol: "BNB",
    pillClass: "",
    addParams: {
      chainId: "0x38", chainName: "BNB Smart Chain Mainnet",
      nativeCurrency: { name: "BNB", symbol: "BNB", decimals: 18 },
      rpcUrls: ["https://bsc-dataseed.binance.org"],
      blockExplorerUrls: ["https://bscscan.com"]
    },
    contracts: {
      Treasury:      "0xC1776f36cd8F03C48FC4c9019Ce8975A529b2443",
      TokenDeployer: "0xB4104C0962B642aaFab6e72783478dF6C97B032B",
      Factory:       "0x2179c3216F07efB54c3A085Fa9B54F6FdC4B2d57",
    }
  },
  shibarium: {
    name: "Shibarium Mainnet",
    chainId: 109,
    chainIdHex: "0x6d",
    rpc: "https://rpc.shibarium.shib.io",
    explorer: "https://shibariumscan.io",
    nativeSymbol: "BONE",
    pillClass: "shib",
    addParams: {
      chainId: "0x6d", chainName: "Shibarium",
      nativeCurrency: { name: "BONE", symbol: "BONE", decimals: 18 },
      rpcUrls: ["https://rpc.shibarium.shib.io"],
      blockExplorerUrls: ["https://shibariumscan.io"]
    },
    contracts: {
      Treasury:      "0xa914002317C68134bEda7599957748950495c9eB",
      TokenDeployer: "0x382B939914a78A413354C7605D1D7AF9A957DB5c",
      Factory:       "0xdF2845DC33F704125EAA304f1C079ABB9c494e27",
    }
  }
};

const ABI = {}; // populated below
const STATE = {
  net: "bsc",
  provider: null,        // BrowserProvider (with signer)
  signer: null,
  rpc: null,             // JsonRpcProvider (read-only fallback)
  addr: null,
  chainOk: false,
};

/* ============================================================
   工具
   ============================================================ */
const $ = (sel) => document.querySelector(sel);
const $$ = (sel) => document.querySelectorAll(sel);
const ZERO = "0x0000000000000000000000000000000000000000";
const log = (msg, cls="") => {
  const el = $("#log"); el.classList.add("show");
  const ts = new Date().toLocaleTimeString();
  const div = document.createElement("div");
  div.className = "entry";
  div.innerHTML = `<span class="ts">[${ts}]</span> <span class="${cls}">${msg}</span>`;
  el.appendChild(div); el.scrollTop = el.scrollHeight;
};
const shortAddr = (a) => a ? `${a.slice(0,6)}…${a.slice(-4)}` : "—";
const copy = (txt) => navigator.clipboard.writeText(txt).then(()=>log(`已复制: ${shortAddr(txt)}`,"info"));
const cur = () => CONFIG[STATE.net];
const fmt = (bn, decimals=18, digits=6) => {
  try { return Number(ethers.formatUnits(bn, decimals)).toLocaleString(undefined,{maximumFractionDigits:digits}); }
  catch { return String(bn); }
};
const parseAddr = (v) => {
  v = (v||"").trim();
  if (!ethers.isAddress(v)) throw new Error("地址格式错误: " + v);
  return ethers.getAddress(v);
};
const parseEth = (v) => {
  v = (v||"").trim();
  if (!v || isNaN(Number(v))) throw new Error("金额必须为数字: " + v);
  return ethers.parseEther(v);
};
const parseUint = (v) => {
  v = (v||"").trim();
  if (!/^\d+$/.test(v)) throw new Error("必须为正整数: " + v);
  return BigInt(v);
};

/* read-only contract (works without wallet) */
const roContract = (name) => new ethers.Contract(cur().contracts[name], ABI[name], STATE.rpc);
/* signing contract (requires wallet) */
const wrContract = (name) => {
  if (!STATE.signer) throw new Error("请先连接钱包");
  return new ethers.Contract(cur().contracts[name], ABI[name], STATE.signer);
};
</script>

<script>
/* ============================================================
   ABI 定义（来自合约源码）
   ============================================================ */
ABI.Treasury = [
  "function owner() view returns (address)",
  "function pendingOwner() view returns (address)",
  "function instantLimit() view returns (uint256)",
  "function MAX_INSTANT_LIMIT() view returns (uint256)",
  "function TIMELOCK() view returns (uint256)",
  "function pendingWithdraw() view returns (address target,uint256 amount,address token,uint256 readyAt,bool exists)",
  "function pendingRescue()   view returns (address target,uint256 amount,address token,uint256 readyAt,bool exists)",
  "function withdraw(address to,uint256 amount)",
  "function proposeWithdraw(address to,uint256 amount)",
  "function executeWithdraw()",
  "function cancelWithdraw()",
  "function proposeRescueERC20(address token,address to,uint256 amount)",
  "function executeRescueERC20()",
  "function cancelRescue()",
  "function setInstantLimit(uint256 newLimit)",
  "function transferOwnership(address newOwner)",
  "function acceptOwnership()",
  "function cancelOwnershipTransfer()",
];

ABI.Factory = [
  "function owner() view returns (address)",
  "function pendingOwner() view returns (address)",
  "function creationFee() view returns (uint256)",
  "function platformTaxBps() view returns (uint16)",
  "function router() view returns (address)",
  "function wbnb() view returns (address)",
  "function tokenDeployer() view returns (address)",
  "function treasury() view returns (address)",
  "function deploymentsLength() view returns (uint256)",
  "function setCreationFee(uint256 newFee)",
  "function setPlatformTaxBps(uint16 newBps)",
  "function transferOwnership(address newOwner)",
  "function acceptOwnership()",
  "function cancelOwnershipTransfer()",
  "function resetTokenSwap(address tokenAddr)",
  "function emergencyDistributeTokenBuckets(address tokenAddr)",
  "function rescueTokenETH(address tokenAddr,address to,uint256 amount)",
  "function setTokenSwapThreshold(address tokenAddr,uint256 newVal)",
];

ABI.TokenDeployer = [
  "function admin() view returns (address)",
  "function factory() view returns (address)",
  "function setFactory(address _factory)",
  "function tokenInitCodeHash(uint16 slippageBps) view returns (bytes32)",
];

/* ============================================================
   连接钱包 / 网络切换
   ============================================================ */
async function connectWallet() {
  if (!window.ethereum) {
    log("未检测到注入式钱包（MetaMask / Rabby / OKX 等）", "err");
    alert("未检测到浏览器钱包，请安装 MetaMask 或类似钱包后刷新。");
    return;
  }
  try {
    STATE.provider = new ethers.BrowserProvider(window.ethereum);
    await window.ethereum.request({ method: "eth_requestAccounts" });
    await ensureChain();
    STATE.signer = await STATE.provider.getSigner();
    STATE.addr = await STATE.signer.getAddress();
    await refreshAll();
    log(`已连接 ${shortAddr(STATE.addr)} @ ${cur().name}`, "ok");
  } catch (e) {
    log("连接失败: " + (e.shortMessage||e.message), "err");
  }
}

async function ensureChain() {
  const want = cur().chainIdHex;
  const cid = await window.ethereum.request({ method: "eth_chainId" });
  if (cid.toLowerCase() === want.toLowerCase()) { STATE.chainOk = true; return; }
  try {
    await window.ethereum.request({ method: "wallet_switchEthereumChain", params: [{ chainId: want }] });
  } catch (err) {
    if (err.code === 4902 || /Unrecognized chain/i.test(err.message||"")) {
      await window.ethereum.request({ method: "wallet_addEthereumChain", params: [cur().addParams] });
    } else throw err;
  }
  STATE.chainOk = true;
}

async function switchNet() {
  STATE.net = $("#netSelect").value;
  STATE.rpc = new ethers.JsonRpcProvider(cur().rpc, cur().chainId, { staticNetwork: true });
  $("#netTag").textContent = cur().name;
  $("#netTag").className = "net-pill " + cur().pillClass;
  if (STATE.signer) {
    try { await ensureChain(); STATE.signer = await STATE.provider.getSigner(); STATE.addr = await STATE.signer.getAddress(); }
    catch (e) { log("切链失败: " + (e.shortMessage||e.message), "err"); }
  }
  renderSections();
  await refreshAll();
}

/* ============================================================
   交易执行通用包装
   ============================================================ */
async function send(label, fn) {
  try {
    if (!STATE.signer) throw new Error("请先连接钱包");
    await ensureChain();
    log(`→ ${label} 发起中…`, "info");
    const tx = await fn();
    log(`  tx <a href="${cur().explorer}/tx/${tx.hash}" target="_blank">${shortAddr(tx.hash)}</a> 已广播，等待确认…`, "info");
    const rcpt = await tx.wait();
    log(`  ✅ ${label} 已上链 block=${rcpt.blockNumber} gasUsed=${rcpt.gasUsed}`, "ok");
    await refreshAll();
  } catch (e) {
    log(`  ❌ ${label} 失败: ${e.shortMessage||e.reason||e.message}`, "err");
  }
}

/* ============================================================
   状态读取与渲染
   ============================================================ */
async function refreshAll() {
  if (!STATE.rpc) STATE.rpc = new ethers.JsonRpcProvider(cur().rpc, cur().chainId, { staticNetwork: true });
  // wallet block
  if (STATE.signer) {
    $("#walletInfo").style.display = "";
    try {
      const [bal, bn] = await Promise.all([
        STATE.rpc.getBalance(STATE.addr),
        STATE.rpc.getBlockNumber()
      ]);
      $("#wAddr").innerHTML = `${STATE.addr} <span class="copy" onclick="copy('${STATE.addr}')">📋</span>`;
      $("#wBal").textContent = `${fmt(bal)} ${cur().nativeSymbol}`;
      $("#wChain").textContent = cur().chainId;
      $("#wBlock").textContent = bn;
      $("#netStatus").textContent = "已连接 " + shortAddr(STATE.addr);
      $("#netStatus").className = "pill ok";
    } catch (e) { log("读取钱包状态失败: " + e.message, "err"); }
  }
  // overview
  await renderOverview();
}

async function renderOverview() {
  const body = $("#overviewBody");
  body.innerHTML = `<div class="hint">读取中…</div>`;
  try {
    const t = roContract("Treasury");
    const f = roContract("Factory");
    const d = roContract("TokenDeployer");
    const [
      tOwner,tPending,tInstantLimit,tMaxLimit,tPendW,tPendR,tBal,
      fOwner,fPending,fCFee,fPlat,fRouter,fWbnb,fTreasury,fTokenDep,fDepLen,
      dAdmin,dFactory
    ] = await Promise.all([
      t.owner(), t.pendingOwner(), t.instantLimit(), t.MAX_INSTANT_LIMIT(), t.pendingWithdraw(), t.pendingRescue(),
      STATE.rpc.getBalance(cur().contracts.Treasury),
      f.owner(), f.pendingOwner(), f.creationFee(), f.platformTaxBps(),
      f.router(), f.wbnb(), f.treasury(), f.tokenDeployer(), f.deploymentsLength(),
      d.admin(), d.factory()
    ]);
    const me = STATE.addr ? STATE.addr.toLowerCase() : "";
    const ownerPill = (o) => {
      if (!me) return `<span class="pill">未连钱包</span>`;
      return o.toLowerCase() === me
        ? `<span class="pill ok">你是 Owner</span>`
        : `<span class="pill warn">非 Owner</span>`;
    };
    const link = (a) => `<a href="${cur().explorer}/address/${a}" target="_blank" class="mono">${a}</a> <span class="copy" onclick="copy('${a}')">📋</span>`;
    body.innerHTML = `
      <div class="grid2">
        <div>
          <h3>Treasury ${ownerPill(tOwner)}</h3>
          <div class="stat"><div class="k">合约地址</div><div class="v">${link(cur().contracts.Treasury)}</div></div>
          <div class="stat"><div class="k">Owner</div><div class="v">${tOwner}</div></div>
          <div class="stat"><div class="k">PendingOwner</div><div class="v">${tPending === ZERO ? "（无）" : tPending}</div></div>
          <div class="stat"><div class="k">余额 / 即时上限 / 硬顶</div><div class="v">${fmt(tBal)} ${cur().nativeSymbol} · ${fmt(tInstantLimit)} · ${fmt(tMaxLimit)}</div></div>
          <div class="stat"><div class="k">待执行大额提款</div><div class="v">${tPendW.exists ? `to ${shortAddr(tPendW.target)} · ${fmt(tPendW.amount)} ${cur().nativeSymbol} · readyAt ${new Date(Number(tPendW.readyAt)*1000).toLocaleString()}` : "（无）"}</div></div>
          <div class="stat"><div class="k">待执行 ERC20 救援</div><div class="v">${tPendR.exists ? `token ${shortAddr(tPendR.token)} → ${shortAddr(tPendR.target)} · ${tPendR.amount.toString()} (raw) · readyAt ${new Date(Number(tPendR.readyAt)*1000).toLocaleString()}` : "（无）"}</div></div>
        </div>
        <div>
          <h3>Factory ${ownerPill(fOwner)}</h3>
          <div class="stat"><div class="k">合约地址</div><div class="v">${link(cur().contracts.Factory)}</div></div>
          <div class="stat"><div class="k">Owner</div><div class="v">${fOwner}</div></div>
          <div class="stat"><div class="k">PendingOwner</div><div class="v">${fPending === ZERO ? "（无）" : fPending}</div></div>
          <div class="stat"><div class="k">creationFee / platformTaxBps</div><div class="v">${fmt(fCFee)} ${cur().nativeSymbol} · ${fPlat} bps (${(Number(fPlat)/100).toFixed(2)}%)</div></div>
          <div class="stat"><div class="k">router / WBNB</div><div class="v">${shortAddr(fRouter)} · ${shortAddr(fWbnb)}</div></div>
          <div class="stat"><div class="k">treasury / tokenDeployer</div><div class="v">${shortAddr(fTreasury)} · ${shortAddr(fTokenDep)}</div></div>
          <div class="stat"><div class="k">已部署 token 数量</div><div class="v">${fDepLen.toString()}</div></div>
        </div>
        <div>
          <h3>TokenDeployer <span class="pill">admin = immutable</span></h3>
          <div class="stat"><div class="k">合约地址</div><div class="v">${link(cur().contracts.TokenDeployer)}</div></div>
          <div class="stat"><div class="k">admin（不可改）</div><div class="v">${dAdmin}</div></div>
          <div class="stat"><div class="k">factory（只能 set 一次）</div><div class="v">${dFactory === ZERO ? "（未设置）" : dFactory}</div></div>
          <p class="hint">本合约 admin 写在 immutable 中，无任何函数能修改；setFactory 已使用过，admin 没有可继续行使的操作。</p>
        </div>
      </div>`;
  } catch (e) {
    body.innerHTML = `<div class="hint" style="color:var(--danger)">读取失败: ${e.message}</div>`;
  }
}

/* ============================================================
   动态 UI：Treasury / Factory 操作区
   ============================================================ */
function renderSections() {
  const native = cur().nativeSymbol;
  $("#sections").innerHTML = `

    <!-- ============ Treasury ============ -->
    <div class="card">
      <h2>💰 Treasury 操作 <span class="tag">${cur().contracts.Treasury}</span></h2>

      <h3>所有权 (Ownable2Step)</h3>
      <div class="row">
        <div><label>新 owner 地址</label><input id="t_newOwner" class="mono" placeholder="0x..." value="0xf94f02057e08de2f2658f69467adda79cb61389a"/></div>
        <button onclick="h.t_transfer()">transferOwnership</button>
      </div>
      <div class="row" style="margin-top:8px">
        <button class="ghost" onclick="h.t_accept()">acceptOwnership (新 owner 调用)</button>
        <button class="warn" onclick="h.t_cancelXfer()">cancelOwnershipTransfer</button>
      </div>

      <h3>即时提款上限</h3>
      <div class="row">
        <div><label>新上限 (${native}，≤ 5)</label><input id="t_limit" class="mono" placeholder="例如 1"/></div>
        <button onclick="h.t_setLimit()">setInstantLimit</button>
      </div>

      <h3>即时提款（小额）</h3>
      <div class="row">
        <div><label>收款地址</label><input id="t_wTo" class="mono" placeholder="0x..."/></div>
        <div><label>金额 (${native}，≤ 即时上限)</label><input id="t_wAmt" class="mono" placeholder="0.5"/></div>
        <button onclick="h.t_withdraw()">withdraw</button>
      </div>

      <h3>大额提款（24h timelock）</h3>
      <div class="row">
        <div><label>收款地址</label><input id="t_pwTo" class="mono" placeholder="0x..."/></div>
        <div><label>金额 (${native}，> 即时上限)</label><input id="t_pwAmt" class="mono" placeholder="10"/></div>
        <button class="warn" onclick="h.t_proposeW()">proposeWithdraw</button>
      </div>
      <div class="row" style="margin-top:8px">
        <button class="ok" onclick="h.t_execW()">executeWithdraw (到期后)</button>
        <button class="danger" onclick="h.t_cancelW()">cancelWithdraw</button>
      </div>

      <h3>ERC20 救援（24h timelock）</h3>
      <div class="row">
        <div><label>ERC20 token 地址</label><input id="t_rTok" class="mono" placeholder="0x..."/></div>
        <div><label>收款地址</label><input id="t_rTo" class="mono" placeholder="0x..."/></div>
        <div><label>数量 (raw，按 token 实际 decimals)</label><input id="t_rAmt" class="mono" placeholder="1000000000000000000"/></div>
        <button class="warn" onclick="h.t_proposeR()">proposeRescueERC20</button>
      </div>
      <div class="row" style="margin-top:8px">
        <button class="ok" onclick="h.t_execR()">executeRescueERC20 (到期后)</button>
        <button class="danger" onclick="h.t_cancelR()">cancelRescue</button>
      </div>
    </div>

    <!-- ============ Factory ============ -->
    <div class="card">
      <h2>🏭 Factory 操作 <span class="tag">${cur().contracts.Factory}</span></h2>

      <h3>所有权 (Ownable2Step)</h3>
      <div class="row">
        <div><label>新 owner 地址</label><input id="f_newOwner" class="mono" placeholder="0x..." value="0xf94f02057e08de2f2658f69467adda79cb61389a"/></div>
        <button onclick="h.f_transfer()">transferOwnership</button>
      </div>
      <div class="row" style="margin-top:8px">
        <button class="ghost" onclick="h.f_accept()">acceptOwnership (新 owner 调用)</button>
        <button class="warn" onclick="h.f_cancelXfer()">cancelOwnershipTransfer</button>
      </div>

      <h3>平台配置</h3>
      <div class="row">
        <div><label>创建费 (${native}，≤ 0.01)</label><input id="f_cFee" class="mono" placeholder="例如 0.001"/></div>
        <button onclick="h.f_setFee()">setCreationFee</button>
      </div>
      <div class="row" style="margin-top:8px">
        <div><label>平台税率 bps (≤ 2000 = 20%)</label><input id="f_tax" class="mono" placeholder="例如 200"/></div>
        <button onclick="h.f_setTax()">setPlatformTaxBps</button>
      </div>

      <h3>已部署 Token 的应急操作</h3>
      <div class="row">
        <div><label>目标 Token 地址</label><input id="f_tokAddr" class="mono" placeholder="0x..."/></div>
      </div>
      <div class="row" style="margin-top:8px">
        <button class="warn" onclick="h.f_resetSwap()">resetTokenSwap（重置熔断器）</button>
        <button class="warn" onclick="h.f_emergencyDist()">emergencyDistributeTokenBuckets（紧急分发税桶）</button>
      </div>

      <hr/>
      <h3>救援 Token 锁死的原生币</h3>
      <div class="row">
        <div><label>目标 Token 地址</label><input id="f_resTok" class="mono" placeholder="0x..."/></div>
        <div><label>收款地址</label><input id="f_resTo" class="mono" placeholder="0x..."/></div>
        <div><label>数量 (${native})</label><input id="f_resAmt" class="mono" placeholder="0.5"/></div>
        <button class="warn" onclick="h.f_rescueETH()">rescueTokenETH</button>
      </div>

      <hr/>
      <h3>修改 Token 的 swapThreshold</h3>
      <div class="row">
        <div><label>目标 Token 地址</label><input id="f_stTok" class="mono" placeholder="0x..."/></div>
        <div><label>新 threshold (raw uint, 含 18 位 decimals)</label><input id="f_stVal" class="mono" placeholder="1000000000000000000000"/></div>
        <button onclick="h.f_setThreshold()">setTokenSwapThreshold</button>
      </div>
      <p class="hint">软性范围 0.01%–0.5% 的 totalSupply，过低/过高会被 Token 合约 revert。</p>
    </div>
  `;
}

/* ============================================================
   Handlers
   ============================================================ */
const h = {
  // Treasury
  t_transfer: () => send("Treasury.transferOwnership", () => wrContract("Treasury").transferOwnership(parseAddr($("#t_newOwner").value))),
  t_accept:   () => send("Treasury.acceptOwnership",   () => wrContract("Treasury").acceptOwnership()),
  t_cancelXfer: () => { if (!confirm("确认取消 Treasury 待执行的所有权转移？")) return; send("Treasury.cancelOwnershipTransfer", () => wrContract("Treasury").cancelOwnershipTransfer()); },
  t_setLimit: () => send("Treasury.setInstantLimit",   () => wrContract("Treasury").setInstantLimit(parseEth($("#t_limit").value))),
  t_withdraw: () => send("Treasury.withdraw",          () => wrContract("Treasury").withdraw(parseAddr($("#t_wTo").value), parseEth($("#t_wAmt").value))),
  t_proposeW: () => send("Treasury.proposeWithdraw",   () => wrContract("Treasury").proposeWithdraw(parseAddr($("#t_pwTo").value), parseEth($("#t_pwAmt").value))),
  t_execW:    () => send("Treasury.executeWithdraw",   () => wrContract("Treasury").executeWithdraw()),
  t_cancelW:  () => { if (!confirm("确认取消大额提款提案？")) return; send("Treasury.cancelWithdraw", () => wrContract("Treasury").cancelWithdraw()); },
  t_proposeR: () => send("Treasury.proposeRescueERC20",() => wrContract("Treasury").proposeRescueERC20(parseAddr($("#t_rTok").value), parseAddr($("#t_rTo").value), parseUint($("#t_rAmt").value))),
  t_execR:    () => send("Treasury.executeRescueERC20",() => wrContract("Treasury").executeRescueERC20()),
  t_cancelR:  () => { if (!confirm("确认取消 ERC20 救援提案？")) return; send("Treasury.cancelRescue", () => wrContract("Treasury").cancelRescue()); },

  // Factory
  f_transfer: () => send("Factory.transferOwnership",  () => wrContract("Factory").transferOwnership(parseAddr($("#f_newOwner").value))),
  f_accept:   () => send("Factory.acceptOwnership",    () => wrContract("Factory").acceptOwnership()),
  f_cancelXfer: () => { if (!confirm("确认取消 Factory 待执行的所有权转移？")) return; send("Factory.cancelOwnershipTransfer", () => wrContract("Factory").cancelOwnershipTransfer()); },
  f_setFee:   () => send("Factory.setCreationFee",     () => wrContract("Factory").setCreationFee(parseEth($("#f_cFee").value))),
  f_setTax:   () => {
    const v = Number($("#f_tax").value);
    if (!Number.isInteger(v) || v < 0 || v > 2000) return log("平台税率必须为 0~2000 的整数", "err");
    send("Factory.setPlatformTaxBps", () => wrContract("Factory").setPlatformTaxBps(v));
  },
  f_resetSwap:    () => { if (!confirm("确认 resetTokenSwap？仅在 token swap 熔断后使用")) return; send("Factory.resetTokenSwap", () => wrContract("Factory").resetTokenSwap(parseAddr($("#f_tokAddr").value))); },
  f_emergencyDist:() => { if (!confirm("确认紧急分发税桶 token？")) return; send("Factory.emergencyDistributeTokenBuckets", () => wrContract("Factory").emergencyDistributeTokenBuckets(parseAddr($("#f_tokAddr").value))); },
  f_rescueETH:    () => send("Factory.rescueTokenETH", () => wrContract("Factory").rescueTokenETH(parseAddr($("#f_resTok").value), parseAddr($("#f_resTo").value), parseEth($("#f_resAmt").value))),
  f_setThreshold: () => send("Factory.setTokenSwapThreshold", () => wrContract("Factory").setTokenSwapThreshold(parseAddr($("#f_stTok").value), parseUint($("#f_stVal").value))),
};
window.h = h; window.copy = copy;

/* ============================================================
   事件绑定 + 初始化
   ============================================================ */
$("#connectBtn").onclick = connectWallet;
$("#refreshAll").onclick = refreshAll;
$("#netSelect").onchange = switchNet;
$("#logToggle").onclick = () => $("#log").classList.toggle("show");

if (window.ethereum) {
  window.ethereum.on("accountsChanged", async () => {
    if (STATE.provider) { STATE.signer = await STATE.provider.getSigner(); STATE.addr = await STATE.signer.getAddress(); await refreshAll(); }
  });
  window.ethereum.on("chainChanged", () => location.reload());
}

(async () => {
  STATE.rpc = new ethers.JsonRpcProvider(cur().rpc, cur().chainId, { staticNetwork: true });
  $("#netTag").textContent = cur().name;
  $("#netTag").className = "net-pill " + cur().pillClass;
  renderSections();
  await refreshAll();
  log("面板就绪。点击右上 [连接钱包] 开始。", "info");
})();
</script>

</body>
</html>
